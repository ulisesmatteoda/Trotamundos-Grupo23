{
  "name": "trotamundos-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de Trotamundos: API (Gateway + Lógica de Negocio) y Workers asincrónicos",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/workers/main.js",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/workers/main.ts"
  },
  "dependencies": {
    "amqplib": "0.10.5",
    "express": "4.21.2",
    "ioredis": "5.4.2",
    "jsonwebtoken": "9.0.2",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/amqplib": "0.10.6",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
